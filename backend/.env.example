# Copy to .env and adjust as needed
PORT=3000
DATABASE_URL=postgres://threadline:threadline@localhost:5432/threadline
# Optional: personal access token to raise the GitHub API rate limit
# (used when enriching `github` post types). Unauthenticated works but is 60 req/hr.
GITHUB_TOKEN=

# Local-disk store for user-uploaded video files.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800
# Absolute base for building public file URLs (defaults to http://localhost:$PORT).
PUBLIC_BASE_URL=http://localhost:3000
